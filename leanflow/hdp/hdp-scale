                "1",
                "--statement-candidate-workers",
                "1",
            )
        )
    return base


def failure_kind(attempts: list[dict], exit_code: int) -> str:
    """Classify only new receipts, keeping missing receipts an infrastructure error."""
    if not attempts:
        return "infrastructure"
    fields = " ".join(
        str(a.get(k, ""))
        for a in attempts
        for k in (
            "failure_class",
            "reason",
            "final_diagnostic",
            "error",
            "failure_stage",
        )
    ).lower()
    if re.search(
        r"\b(401|403)\b|invalid.api.key|authentication|unauthorized|access denied",
        fields,
    ):
        return "auth"
    if re.search(r"quota|insufficient.credit|余额不足|额度不足|insufficient.balance", fields):
        return "quota"
    if re.search(r"\b429\b|rate.?limit|too.many.requests|gateway_concurrency_limit", fields):
        return "rate_limit"
    # The relay's own "upstream down, retry" failures (a 400 with type
    # upstream_error, or 5xx with the same message). Separate from
    # ``infrastructure`` so a proof hit by one pauses dispatch briefly instead of
    # forcing task recovery, which drains the whole wave.
    if re.search(r"upstream_error|请稍后重试|重新发起请求|retry shortly", fields):
        return "relay_transient"
    if any(
        a.get("infrastructure_failure")
        or a.get("retry_class") == "infrastructure"
        or a.get("failure_class") in {"infrastructure", "transport", "provider_unavailable"}
        for a in attempts
    ):
        return "infrastructure"
    if exit_code == 0 and attempts[-1].get("success"):
        return "accepted"
    if any(
        a.get("review_decision") == "BLOCK"
        or a.get("retry_class") == "semantic"
        or a.get("failure_class") in {"semantic_review_block", "statement_generation_incomplete"}
        or a.get("failure_stage")
        in {"semantic_review", "semantic_contract", "lean_compilation", "format_check"}
        for a in attempts
    ):
        return "semantic"
    return "infrastructure"


def item_receipts(item: dict, batch: dict) -> list[dict]:
    """Match fresh receipts to this child's emitted worker identity and stage."""
    text = Path(item["log"]).read_text(errors="replace")[-2_000_000:]
    decoder = json.JSONDecoder()
    owner = str(item.get("observed_worker_id", "") or "")
    stage = str(item.get("stage", "statements") or "statements")
    # The child records the fingerprint of the credential it actually resolved,
    # so an auth failure can be attributed to a pool member without recomputing
    # hdp-run's slot arithmetic here (which would drift if that rule changed).
    credential = re.search(r'"credential_sha256":\s*"([a-f0-9]{64})"', text)
    if credential:
        item["credential_sha256"] = credential.group(1)
    for start in re.finditer(r"(?m)^\{", text):
        try:
            payload, _ = decoder.raw_decode(text[start.start() :])
        except ValueError:
            continue
        if payload.get("batch_id") == item["batch_id"] and payload.get("stage") == stage:
            candidate = str(
                payload.get("worker_id") or payload.get("outcome", {}).get("worker_id", "") or ""
            )
            if candidate:
                owner = candidate
                item["child_result"] = {
                    k: payload.get(k)
                    for k in ("batch_id", "stage", "worker_id", "exit_code", "success")
                }
    if not owner:
        return []
    item["worker_id"] = owner
    return [
        a
        for a in batch.get("attempts", [])[item["attempts_before"] :]
        if a.get("worker_id") == owner and a.get("stage") == stage
    ]


def _file_digest(path: str | Path) -> str | None:
    """Return a file digest for recovery reconciliation, or ``None`` if absent."""
    candidate = Path(path)
    try:
        if not candidate.is_file():
            return None
        return digest(candidate.read_bytes())
    except (OSError, ValueError):
        return None


def recovery_snapshot(target_path: str) -> dict | None:
    """Hash the assigned Lean directory; unreadable or absent targets cannot recover."""
    target = Path(target_path)
    if not target_path or not target.is_file():
        return None
    try:
        return {str(p): digest(p.read_bytes()) for p in sorted(target.parent.rglob("*.lean"))}
    except OSError:
        return None


def recovery_runtime_idle(*, run=subprocess.run) -> dict:
    """Check both hosts after draining; uncertainty never authorizes a restart.

    When the orchestrator runs on the Lean host itself there is no second host to
    ask. The SSH probe below would then be a connection to ourselves, and since
    self-login is not authorized on this box it would fail, the exception handler
    would report ``checked: False``, and every restart would be refused forever.
    On a single host one process table answers both questions, so scan it once.
    """
    single_host = str(os.getenv("HDP_LOCAL_LEAN_HOST", "") or "").strip().lower() in {
        "1",
        "true",
        "yes",
        "on",
    }
    if single_host:
        try:
            local = run(
                ["ps", "-axo", "pid=,command="],
                capture_output=True,
                text=True,
                check=True,
                timeout=15,
            ).stdout
            busy_pids = local_runtime_pids(local)
            # The orchestrator's own warm probe is expected to be alive here --
            # it is started before dispatch and answers the verification lane's
            # checks. Counting it as a busy runtime made every restart refuse
            # itself: the probe was running, so `execute` raised
            # "statement handoff requires idle local and remote runtimes" and the
            # run died seconds after starting. Exclude only the service the
            # parent owns; a *different* probe still counts, because that is a
            # second orchestrator and the guard exists to catch exactly that.
            own_probe = own_warm_probe_pids(local)
            busy_pids = [pid for pid in busy_pids if pid not in own_probe]
            idle = not busy_pids
            return {
                "checked": True,
                "local_idle": idle,
                "local_busy_pids": busy_pids,
                "own_warm_probe_pids": own_probe,
                "remote_idle": idle,
                "single_host": True,
            }
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            return {"checked": False, "local_idle": False, "remote_idle": False}
    try:
        local = run(
            ["ps", "-axo", "pid=,command="],
            capture_output=True,
            text=True,
            check=True,
            timeout=15,
        ).stdout
        busy_pids = local_runtime_pids(local)
        local_busy = bool(busy_pids)
        remote = run(
            [
                "ssh",
                "-p",
                "22",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=10",
                "lean@lean-host.example",
                remote_project_probe_command("/srv/lean/fate-x-work"),
            ],
            capture_output=True,
            text=True,
            check=True,
            timeout=20,
        ).stdout
        remote_state = json.loads(remote)
        if remote_state.get("checked") is not True:
            raise ValueError("remote process scope could not be checked")
        remote_busy = bool(remote_state["busy_pids"])
        return {
            "checked": True,
            "local_idle": not local_busy,
            "local_busy_pids": busy_pids,
            "remote_idle": not remote_busy,
        }
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return {"checked": False, "local_idle": False, "remote_idle": False}


def _missing_receipt_recovery(item: dict, batch: dict, exit_code: int) -> dict:
    """Defer an exhausted proof only with positive source, ledger and runtime evidence.

    Console rollback messages alone carry no authority. No success receipt is
    synthesized and the failed item is excluded for the rest of this run.
    """
    result = item.get("child_result", {})
    runtime = item.get("recovery_runtime", {})
    before = item.get("recovery_source_before")
    after = recovery_snapshot(str(item.get("target_path", "")))
    attempts = batch.get("attempts", [])
    ledger_unchanged = item.get("attempts_before_sha256") == digest(
        json.dumps(attempts, sort_keys=True).encode()
    )
    target_unchanged = bool(before and before == after)
    child_timeout = (
        item.get("stage") == "proofs"
        and result.get("stage") == "proofs"
        and result.get("batch_id") == item.get("batch_id")
        and bool(item.get("worker_id"))
        and result.get("worker_id") == item.get("worker_id")
        and result.get("exit_code") == 124
        and result.get("success") is False
    )
    idle = all(runtime.get(k) is True for k in ("checked", "local_idle", "remote_idle"))
    safe = bool(
        child_timeout
        and exit_code == 1
        and not batch.get("lease")
        and ledger_unchanged
        and target_unchanged
        and idle
    )
    return {
        "kind": "action_timeout" if child_timeout else "unknown_missing_receipt",
        "lease_released": not bool(batch.get("lease")),
        "target_unchanged": target_unchanged,
        "attempts_unchanged": ledger_unchanged,
        "runtime": runtime,
        "safe_to_retry": safe,
        "disposition": "defer_for_this_run" if safe else "manual_reconciliation",
        "manual_reconciliation_required": not safe,
    }


def reconcile_missing_receipts(state: dict, campaign: Path, *, check=None) -> None:
    """Recheck missing outcomes after all workers drain, before any quota rollover."""
    missing = [i for i in state["items"] if not i.get("new_attempts")]
    if not missing or state.get("active"):
        return
    runtime = (check or recovery_runtime_idle)()
    batches = {b["id"]: b for b in load(campaign)["batches"]}
    for item in missing:
        item["recovery_runtime"] = runtime
        item["receipt_recovery"] = _missing_receipt_recovery(
            item, batches.get(item["batch_id"], {}), item["exit_code"]
        )


@contextmanager
def controller_lock(project: Path):
    """Admit one supervising controller for the shared Lean checkout."""
    path = project / ".leanflow" / "scale-controller.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RuntimeError("another HDP scale controller is running") from exc
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


