# times and spent the cooldown windows idle; the failures behind them are
# provider 5xx and timeouts that recur regardless, so a higher threshold trades
# a little wasted work for materially more dispatched batches.
INFRASTRUCTURE_FUSE_THRESHOLD = 6
# Reasons that pause dispatch instead of ending the wave. The fuse fires on a
# burst of provider failures; the batches already in flight are unaffected and
