# 2026-10-03), or the supervisor terminates a child that the runner would still
# have let finish. Raised from 7200 to 16200 in step with that value.
CHILD_WATCHDOG_SECONDS = 16200

# A proof action must operate on a real generated declaration.  In particular,
# an ``import Mathlib`` scaffold is not evidence that a statement was accepted.
_LEAN_DECLARATION_RE = re.compile(
    r"(?m)^\s*(?:(?:noncomputable|private|protected|unsafe)\s+)*" r"(?:theorem|lemma|example)\b"
)
_LEAN_PLACEHOLDER_RE = re.compile(r"\b(?:sorry|admit)\b")
