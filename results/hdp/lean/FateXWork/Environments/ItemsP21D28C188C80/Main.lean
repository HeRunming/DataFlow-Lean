import Mathlib

noncomputable section

namespace SourceConditionalExpectation

/-- The selected representative denoted by E[X | Y]. -/
def conditionalExpectationGiven
    {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (X Y : Ω → ℝ)
    (_hX : Measurable X) (_hY : Measurable Y)
    (_hInt : MeasureTheory.Integrable X μ) : Ω → ℝ :=
  MeasureTheory.condExp (MeasurableSpace.comap Y (borel ℝ)) μ X

/-- Conditioning on Y means conditioning on the sigma-algebra generated by Y. -/
theorem conditionalExpectationGiven_eq
    {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]
    (X Y : Ω → ℝ)
    (hX : Measurable X) (hY : Measurable Y)
    (hInt : MeasureTheory.Integrable X μ) :
    conditionalExpectationGiven μ X Y hX hY hInt =
      MeasureTheory.condExp (MeasurableSpace.comap Y (borel ℝ)) μ X := by sorry

end SourceConditionalExpectation
