import Mathlib

open MeasureTheory

/-- A real-valued function is a conditional expectation of `X` given `Y` if it is
measurable with respect to the sigma-algebra generated by `Y` and agrees with
`X` on all events determined by `Y`. -/
def IsConditionalExpectationGiven
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (X Y coeff : Ω → ℝ) : Prop :=
  Measurable[MeasurableSpace.comap Y (inferInstance : MeasurableSpace ℝ)] coeff ∧
    ∀ s : Set ℝ, MeasurableSet s →
      (∫ ω in Y ⁻¹' s, coeff ω ∂μ) = (∫ ω in Y ⁻¹' s, X ω ∂μ)

/-- The law of total expectation. -/
theorem law_of_total_expectation
    {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X Y : Ω → ℝ)
    (hX_measurable : Measurable X)
    (hY_measurable : Measurable Y)
    (hX_integrable : Integrable X μ)
    (coeff : Ω → ℝ)
    (hcoeff_measurable :
      Measurable[MeasurableSpace.comap Y (inferInstance : MeasurableSpace ℝ)] coeff)
    (hcoeff_integrable : Integrable coeff μ)
    (hcoeff_conditional :
      IsConditionalExpectationGiven μ X Y coeff) :
    (∫ ω, X ω ∂μ) = ∫ ω, coeff ω ∂μ := by
  simpa using (hcoeff_conditional.2 Set.univ MeasurableSet.univ).symm
